DATABASE_URL="postgresql://eventei:eventei@localhost:5432/eventei?schema=public"
BETTER_AUTH_SECRET="generate-a-long-random-secret"
# Public URL where the browser reaches auth (Next.js proxy in local/prod)
BETTER_AUTH_URL="http://localhost:3000"
WEB_URL="http://localhost:3000"
PORT=4000

# OAuth (optional until configured)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=

# Ticketmaster Discovery API
# Consumer Key -> used as apikey (required for live BR inventory)
TICKETMASTER_API_KEY=
# Alias opcional da Consumer Key
TICKETMASTER_CONSUMER_KEY=
# Consumer Secret (reservado; Discovery pública não usa)
TICKETMASTER_CONSUMER_SECRET=
TICKETMASTER_MAX_PAGES=5
TICKETMASTER_PAGE_SIZE=50

# Providers
# false = não usar stubs quando a API falhar/faltar key
ALLOW_PROVIDER_STUBS=true
# 0 = desliga sync automático; ex.: 3600000 = 1h
PROVIDER_SYNC_INTERVAL_MS=0
