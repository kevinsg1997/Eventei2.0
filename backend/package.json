{
  "name": "eventei-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "prisma generate && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "railway:predeploy": "node scripts/railway-predeploy.mjs",
    "start:railway": "npx prisma generate && npx prisma migrate deploy && npm start",
    "test:providers": "tsx src/providers/ticketmaster.test.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/sensible": "^6.0.4",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.4.18",
    "dotenv": "^17.3.1",
    "fastify": "^5.8.2",
    "prisma": "^6.19.0",
    "tsx": "^4.21.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^25.5.0",
    "typescript": "^5.9.3"
  }
}
